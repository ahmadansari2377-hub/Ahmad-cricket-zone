# Copy the lines you need into env/.env (which is never committed or shared).
# Server-only secrets: never prefix these with VITE_ or they would reach the browser.

# Neon dashboard > Connect > connection string (pooled).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Neon dashboard > Auth > Configuration: the Auth URL (same value twice).
# The browser uses VITE_NEON_AUTH_URL to sign in; the API uses NEON_AUTH_BASE_URL to check tokens.
NEON_AUTH_BASE_URL=https://YOUR-PROJECT.neonauth.REGION.aws.neon.tech/neondb/auth
VITE_NEON_AUTH_URL=https://YOUR-PROJECT.neonauth.REGION.aws.neon.tech/neondb/auth
